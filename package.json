{
    "name": "university-and-higher-study-management-backend",
    "version": "1.0.0",
    "description": "Enterprise-grade REST API for Unified University & Global Higher Study Management System",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsup",
        "vercel-build": "prisma generate",
        "start": "node dist/server.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "format:check": "npx @biomejs/biome format ./src",
        "format:fix": "npx @biomejs/biome format --write ./src",
        "lint:check": "npx @biomejs/biome lint ./src",
        "lint:fix": "npx @biomejs/biome lint --write ./src"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.10.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.1",
        "google-auth-library": "^11.0.0",
        "helmet": "^8.1.0",
        "http-status": "^2.1.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "nodemailer": "^9.0.5",
        "pdfkit": "^0.20.1",
        "pg": "^8.22.0",
        "redis": "^6.2.0",
        "stripe": "^17.7.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@types/bcryptjs": "^3.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.2",
        "@types/nodemailer": "^8.0.1",
        "@types/pdfkit": "^0.17.6",
        "@types/pg": "^8.20.0",
        "prisma": "^7.9.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
