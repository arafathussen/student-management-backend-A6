model Department {
  id          String    @id @default(uuid(7))
  name        String    @unique
  code        String    @unique
  description String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  students    Student[]
  faculties   Faculty[]
  courses     Course[]

  @@map("departments")
}

model Semester {
  id          String    @id @default(uuid(7))
  name        String
  code        String    @unique
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean   @default(false)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections    Section[]
  payments    Payment[]
  grades      CourseResult[]

  @@map("semesters")
}

model Course {
  id               String    @id @default(uuid(7))
  title            String
  code             String    @unique
  credits          Int       @default(3)
  tuitionFee       Decimal   @default(15000.00) @db.Decimal(10, 2)
  description      String?

  prerequisiteId   String?
  prerequisite     Course?   @relation("Prerequisites", fields: [prerequisiteId], references: [id])
  dependentCourses Course[]  @relation("Prerequisites")

  departmentId     String
  department       Department @relation(fields: [departmentId], references: [id])

  sections         Section[]

  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([code], name: "idx_course_code")
  @@map("courses")
}

model Section {
  id             String    @id @default(uuid(7))
  sectionName    String
  maxCapacity    Int       @default(40)
  availableSeats Int       @default(40)
  roomNumber     String?
  scheduleTime   String?

  courseId       String
  course         Course    @relation(fields: [courseId], references: [id])

  semesterId     String
  semester       Semester  @relation(fields: [semesterId], references: [id])

  facultyId      String?
  faculty        Faculty?  @relation(fields: [facultyId], references: [id])

  enrollments    Enrollment[]
  attendances    CourseAttendance[]
  grades         CourseResult[]

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([courseId, semesterId, sectionName], name: "unique_section_per_semester")
  @@map("sections")
}

model Enrollment {
  id          String           @id @default(uuid(7))
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  sectionId   String
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  status      EnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime         @default(now())

  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?

  @@unique([studentId, sectionId], name: "unique_student_section_enrollment")
  @@map("enrollments")
}
