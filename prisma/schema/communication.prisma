model ChatRoom {
  id                 String        @id @default(uuid(7))
  applicationId      String?       @unique
  studentUserId      String
  mode               ChatMode      @default(COLLABORATIVE_GROUP)
  isLocked           Boolean       @default(false)
  lockedByAgentId    String?
  lockedByAgentName  String?

  messages           ChatMessage[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("chat_rooms")
}

model ChatMessage {
  id                String    @id @default(uuid(7))
  roomId            String?
  room              ChatRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  message           String
  attachmentUrl     String?
  senderDisplayName String?
  senderRoleBadge   String
  isRead            Boolean   @default(false)

  senderId          String
  sender            User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId        String?
  receiver          User?     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([senderId, receiverId], name: "idx_chat_participants")
  @@map("chat_messages")
}

model Notification {
  id        String               @id @default(uuid(7))
  title     String
  body      String
  audience  NotificationAudience @default(ALL)
  priority  NotificationPriority @default(INFO)
  actionUrl String?
  isRead    Boolean              @default(false)

  userId    String?
  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([userId, isRead], name: "idx_notification_user")
  @@map("notifications")
}
